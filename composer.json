{
  "name": "kinoba/dead-code-bundle",
  "description": "Generate code coverage on live server",
  "type": "symfony-bundle",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Kinoba\\DeadCodeBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kinoba\\DeadCodeBundle\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Kinoba",
      "homepage": "https://www.kinoba.fr"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-pcov": "*",
    "predis/predis": "^2.0",
    "psr/log": "^3.0",
    "symfony/console": "^7.0|^8.0",
    "symfony/framework-bundle": "^7.0|^8.0",
    "symfony/routing": "^7.0|^8.0"
  },
  "require-dev": {
    "carthage-software/mago": "^1.49.0",
    "phpunit/phpunit": "^10.5|^11.5|^12.0"
  },
  "suggest": {
    "symfony/twig-bundle": "To enable the dashboard controller and render the coverage report."
  },
  "config": {
    "sort-packages": true
  }
}
